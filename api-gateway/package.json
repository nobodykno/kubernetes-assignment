{
  "name": "api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Service A: accepts jobs over HTTP and pushes them onto a Redis queue",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
   "build": "tsc && tsc-alias",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
  "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "shared": "workspace:*",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "zod": "^4.4.3",
    "cors": "^2.8.6",
    "express-rate-limit": "^8.6.0",
    "helmet": "^7.0.0",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@jest/globals": "29.7.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "@types/supertest": "^7.2.1",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "@types/morgan": "^1.9.10",
    "@types/cors": "^2.8.19",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "prettier": "^3.9.9",
    "tsc-alias": "^1.9.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
