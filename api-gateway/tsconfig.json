
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "isolatedModules": true,
    "types": ["node", "jest"]
  },
  "include": ["src"]
}