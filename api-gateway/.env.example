# How long job records stay in Redis before being deleted (seconds, 86400 = 24h)
JOB_TTL_SECONDS=


STATS_SERVICE_URL=

# How long to wait for an internal service before returning 504 (milliseconds)
UPSTREAM_TIMEOUT_MS=

# Log one JSON line per request (set to false to keep stress-test output quiet)
LOG_REQUESTS=


RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=