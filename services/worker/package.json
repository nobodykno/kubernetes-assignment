{
  "name": "worker",
  "version": "1.0.0",
  "private": true,
  "description": "Service B: consumes jobs from the Redis queue, runs CPU-heavy work, exposes Prometheus metrics",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "tsc-alias": "^1.9.5",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
